# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Local development (NestJS backend) ──────────────────────────────────────
# Leave this unset to auto-detect: http://{hostname}:3000
# VITE_API_URL=

# ── Production (Google Apps Script backend) ──────────────────────────────────
# Paste your deployed Apps Script web app URL here.
# Get it from: Apps Script editor → Deploy → Manage deployments → Web app URL
# VITE_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
