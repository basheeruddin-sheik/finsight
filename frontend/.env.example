# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Local development ────────────────────────────────────────────────────────
# Leave VITE_API_URL unset to auto-detect: http://{hostname}:3000
# VITE_API_URL=

# ── Auth0 (required) — see AUTH_SETUP.md ─────────────────────────────────────
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://finsight-api

# ── Railway deployment — set these in the Railway service dashboard ───────────
# VITE_API_URL        → https://<your-backend-service>.up.railway.app
# VITE_AUTH0_DOMAIN   → same as above
# VITE_AUTH0_CLIENT_ID → same as above
# VITE_AUTH0_AUDIENCE → same as above
# NOTE: VITE_* vars are baked in at build time — set them before deploying.
