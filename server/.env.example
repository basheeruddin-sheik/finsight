# ── Local development ────────────────────────────────────────────────────────
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finsight

# Auth0 (required) — see AUTH_SETUP.md
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://finsight-api

# ── Railway deployment — set these in the Railway service dashboard ───────────
# PORT        → set automatically by Railway, do not override
# MONGODB_URI → your MongoDB Atlas connection string
# AUTH0_DOMAIN, AUTH0_AUDIENCE → same values as above
